    "import gradio as gr\n",
    "def greet(name):\n",
    "    return f\"Hello {name}!\"\n",
    "\n",
    "# 使用 layout 参数控制布局\n",
    "gr.Interface(fn=greet, \n",
    "             inputs=gr.Textbox(label=\"Enter your name\"), \n",
    "             outputs=gr.Textbox(label=\"Output\"), \n",
    "             ).launch()\n"
   ]
